<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_detail"
    android:minWidth="236dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 这一层会被 detailScale 缩放；设置面板放在外面，滑杆不会被自己缩放 -->
    <LinearLayout
        android:id="@+id/detailContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:text="API 余额"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUpdated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="⚙"
                android:textColor="@color/text_sub"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="2dp"
                android:text="×"
                android:textColor="@color/text_muted"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#1AFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="长按刷新 · 双击收起"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/btnOpenApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="App"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnRefreshDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="刷新"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 悬浮窗设置：不参与 detailScale -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#1AFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="悬浮窗设置"
            android:textColor="@color/text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="自动轮播"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />

            <Switch
                android:id="@+id/swScroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="锁定位置"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />

            <Switch
                android:id="@+id/swLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="常驻展开"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />

            <Switch
                android:id="@+id/swPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="#14FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="胶囊宽度"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPillW"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动"
                android:textColor="@color/accent"
                android:textSize="10sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekPillW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="320"
            android:progress="0"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="胶囊高度"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPillH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动"
                android:textColor="@color/accent"
                android:textSize="10sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekPillH"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="120"
            android:progress="0"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="详情宽度"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvDetailW"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动"
                android:textColor="@color/accent"
                android:textSize="10sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekDetailW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="380"
            android:progress="0"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="胶囊配色"
            android:textColor="@color/text_sub"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/swatchesPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="详情配色"
            android:textColor="@color/text_sub"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/swatchesDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#14FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="胶囊大小"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPillScale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="@color/accent"
                android:textSize="10sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekPillScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="70"
            android:progress="20"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="详情内容"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvDetailScale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="@color/accent"
                android:textSize="10sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekDetailScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="20"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="拖动滑杆，松手生效"
            android:textColor="@color/text_muted"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/btnScaleReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="恢复默认"
            android:textColor="@color/accent"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
